# Stage 1: Build the application
FROM node:18-alpine as build

# Install required packages for building native dependencies
RUN apk add --no-cache openssl python3 make g++

# Install pnpm globally
RUN npm install -g pnpm

# Set the working directory
WORKDIR /app

# Copy package.json first for better layer caching
COPY package.json ./

# Set environment variables
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1

# Install dependencies with lockfile but allow configuration differences
RUN pnpm i --ignore-scripts

# Copy the rest of the application code
COPY . .

# Try building with TypeScript compiler directly instead of nest build
RUN npx tsc --build apps/organization/tsconfig.app.json --verbose || \
    echo "TypeScript build failed, will compile at runtime"

# Fallback: copy source files for runtime compilation
RUN mkdir -p dist/apps/organization && \
    cp -r apps/organization/src dist/apps/organization/ || echo "Source copy completed"


# Stage 2: Create the final image
FROM node:18-alpine
# Install OpenSSL
RUN apk add --no-cache openssl
# RUN npm install -g pnpm
# Set the working directory
WORKDIR /app

# Copy the compiled code from the build stage
COPY --from=build /app/dist/apps/organization/ ./dist/apps/organization/

# Copy the libs folder from the build stage
COPY --from=build /app/libs/ ./libs/
#COPY --from=build /app/package.json ./  
COPY --from=build /app/node_modules  ./node_modules

# Set the command to run the microservice with proper setup
CMD ["sh", "-c", "cd libs/prisma-service && \
    PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 PRISMA_SKIP_DOWNLOAD=true npx prisma migrate deploy --schema=./prisma/schema.prisma && \
    PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 PRISMA_SKIP_DOWNLOAD=true npx prisma generate --schema=./prisma/schema.prisma && \
    cd ../.. && \
    (test -f dist/apps/organization/main.js || pnpm run build organization) && \
    node dist/apps/organization/main.js"]
